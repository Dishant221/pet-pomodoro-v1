---
import '../styles/global.css';
import { isProductionBuild } from '../site';
import Companion from '../islands/Companion';
import SupportWidget from '../islands/SupportWidget';
import ProfileMenu from '../islands/ProfileMenu';

/**
 * The one place every page's `<head>` is assembled.
 *
 * Search engines and social scrapers need three things a single-page app
 * usually forgets: an absolute canonical URL, a description that differs per
 * page, and structured data saying what this thing actually is. All three are
 * built here so no page can quietly ship without them.
 */

interface Props {
  title: string;
  /** Shown in search results and on social cards. ~155 chars is the useful limit. */
  description?: string;
  /** The focus page runs its own full-bleed stage and hides the page chrome. */
  wide?: boolean;
  /** Keep a page out of search results — internal previews and experiments. */
  noindex?: boolean;
  /** JSON-LD to embed, if this page describes a specific thing. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute URL of a page-specific social card; falls back to the site's. */
  ogImage?: string;
  /** Set on blog posts: switches og:type and emits the article:* meta. */
  article?: { publishedAt: Date; updatedAt?: Date; tags: string[] };
}

const {
  title,
  description = 'A free pomodoro timer with a virtual pet. Focus in 25-minute sessions while your cat naps in a hand-painted world that follows your real time of day and weather.',
  wide = false,
  noindex = false,
  schema,
  ogImage: ogImageProp,
  article,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Astro.site comes from `site` in astro.config; canonical must be absolute.
const canonical = new URL(path === '/' ? '/' : `${path}/`, Astro.site).href;
const ogImage = ogImageProp ?? new URL('/og.png', Astro.site).href;

/**
 * Anything that is not the production origin is kept out of search entirely,
 * whatever the page asked for. Preview is publicly reachable, and an indexed
 * preview competes with production for its own keywords.
 */
const hideFromSearch = noindex || !isProductionBuild(Astro.site);

const NAV = [
  { href: '/', label: 'Focus', icon: '🐱' },
  { href: '/stats', label: 'Stats', icon: '📊' },
  { href: '/shop', label: 'Shop', icon: '🛍️' },
  { href: '/gifts', label: 'Gifts', icon: '🎁' },
  { href: '/settings', label: 'Settings', icon: '⚙️' },
  { href: '/blog', label: 'Blog', icon: '📖' },
  { href: '/forum', label: 'Forum', icon: '🗨️' },
  { href: '/about', label: 'About', icon: '💡' },
];

const FOOTER = [
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/cookies', label: 'Cookies' },
  { href: '/copyright', label: 'Copyright' },
  { href: '/disclosure', label: 'Disclosure' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="theme-playful">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hideFromSearch ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta name="theme-color" content="#fff7ed" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* The display face (headings/buttons). Preloaded because it paints the
        largest text on every page; font-display swap keeps text unblocked. */}
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    {/* Site-wide so readers and aggregators can find the feed from any page. */}
    <link rel="alternate" type="application/rss+xml" title="PetPomo" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    {/* Open Graph / Twitter. Absolute URLs only — scrapers do not resolve
        relative ones, and a missing image is the difference between a card
        and a bare grey link. */}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    {article?.tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta property="og:site_name" content="PetPomo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }

    {/* Blocking, and not inlined — see public/boot.js for why. */}
    <script src="/boot.js" is:inline></script>
  </head>

  {/*
    On `wide`, the first screenful is the game and everything after it is
    ordinary page. The body scrolls again — it did not for a while, which kept
    the stage honest but also meant there was nowhere to put anything else, and
    a page whose only content is a canvas has nothing for a reader or a search
    engine to read.

    The stage sizes itself to `100dvh - var(--pp-nav)`, and the nav's height is
    a variable rather than a guess. An earlier version hardcoded 3.25rem, was
    wrong by one footer, and put the pet off the bottom of a scrolling page.
  */}
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="pp-focus-ring sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:px-3 focus:py-2"
      style="background: var(--accent); color: var(--accent-ink);">Skip to content</a
    >

    <header
      class="sticky top-0 z-30 backdrop-blur-md"
      style="background: color-mix(in srgb, var(--bg) 82%, transparent); border-bottom: 1px solid var(--border);"
    >
      <nav class="pp-nav mx-auto flex max-w-5xl items-center gap-1 px-3 sm:gap-2 sm:px-5" aria-label="Main">
        <a
          href="/"
          class="pp-focus-ring mr-auto flex items-center gap-2 rounded-lg font-extrabold tracking-tight"
          style="color: var(--ink)"
        >
          <span aria-hidden="true" class="text-xl">🐾</span>
          <span class="text-lg">PetPomo</span>
        </a>
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="pp-focus-ring rounded-lg px-2 py-1.5 text-sm font-semibold transition-colors sm:px-3"
              style={
                isActive(item.href)
                  ? 'background: var(--accent); color: var(--accent-ink);'
                  : 'color: var(--ink-soft);'
              }
            >
              <span aria-hidden="true" class="sm:hidden">
                {item.icon}
              </span>
              <span class="hidden sm:inline">{item.label}</span>
            </a>
          ))
        }

        {/*
          The account control — sign-in link when logged out, avatar menu when
          logged in. Second from the right, just left of fullscreen.
        */}
        <ProfileMenu client:idle />

        {/*
          Fullscreen. Last in the bar and set apart, because it acts on the
          window rather than navigating anywhere. `public/fullscreen.js` hides
          it outright where the API is unavailable — an iPhone, mainly — rather
          than leaving a button that does nothing when pressed.
        */}
        <button
          type="button"
          data-fullscreen
          aria-pressed="false"
          title="Go fullscreen"
          class="pp-focus-ring pp-fullscreen ml-1 rounded-lg px-2 py-1.5 text-sm font-semibold sm:ml-2"
          style="color: var(--ink-soft)"
        >
          <span aria-hidden="true" class="pp-fs-open">⛶</span>
          <span aria-hidden="true" class="pp-fs-close">✕</span>
          <span class="sr-only">Go fullscreen</span>
        </button>
      </nav>
    </header>

    <main id="main" class={wide ? 'flex-1' : 'mx-auto w-full max-w-5xl flex-1 px-4 py-6 sm:px-5 sm:py-10'}>
      <slot />
    </main>

    {/* The footer is on every page including the full-bleed game. Privacy,
        terms and contact have to be reachable from the page people actually
        land on — both because reviewers look for it and because burying them
        one click deeper helps nobody. On `wide` it collapses to a single
        quiet line so it does not fight the stage. */}
    <footer
      class:list={[
        'mx-auto w-full max-w-5xl px-4 sm:px-5',
        wide ? 'flex flex-wrap items-center gap-x-4 gap-y-1 py-2 text-[11px]' : 'pb-10 pt-6 text-xs',
      ]}
      style={`color: var(--ink-soft); ${wide ? '' : 'border-top: 1px solid var(--border);'}`}
    >
      <nav
        class:list={['flex flex-wrap gap-x-4 gap-y-2', wide ? '' : 'mb-3']}
        aria-label="Footer"
      >
        {
          FOOTER.map((item) => (
            <a href={item.href} class="pp-focus-ring rounded underline-offset-2 hover:underline">
              {item.label}
            </a>
          ))
        }
      </nav>
      <p>
        © {year} PetPomo.{
          !wide && ' Everything is stored on this device — nothing leaves your browser unless you turn on sync.'
        }
      </p>
    </footer>

    {/*
      The pet, when the player has it living on the page rather than in the
      stage. `client:idle` rather than `client:load`: the animal is the least
      urgent thing on any of these routes, and on the blog it is decoration
      over an article someone came to read.
    */}
    <Companion client:idle />

    {/*
      Support is a property of the site, not of the pet, so unlike the talk
      bar it renders on every route in every mode — a stage player reading
      the blog can still report the bug they are looking at.
    */}
    <SupportWidget client:idle />

    <script src="/sw-register.js" is:inline></script>
    <script src="/fullscreen.js" is:inline defer></script>
  </body>
</html>
