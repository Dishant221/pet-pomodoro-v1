---
import Layout from '../layouts/Layout.astro';
import Game from '../islands/Game';
import Comments from '../islands/Comments.tsx';
import FocusLanding from '../components/FocusLanding.astro';
import { SITE, legalName } from '../site';

/**
 * WebApplication + FAQPage on the one page a search engine is most likely to
 * show. The FAQ entries are real questions people type — "is there a free
 * pomodoro timer", "does it work offline" — answered here rather than only in
 * a blog post, because this is the page that will rank for the product terms.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE.name,
    url: new URL('/', Astro.site).href,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: 'Any (web browser)',
    browserRequirements: 'Requires JavaScript. WebGL recommended.',
    description:
      'A free pomodoro focus timer with a virtual pet. Your cat naps through each 25-minute session in a hand-painted world that follows your real time of day and local weather.',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: legalName, url: SITE.url },
    featureList: [
      'Pomodoro timer with configurable focus and break lengths',
      'Virtual pet that reacts to your focus sessions',
      'Hand-painted scenes that follow your local time of day',
      'Real weather from your approximate location, with no location permission',
      'Works offline',
      'No account required',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is PetPomo free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, completely. There are no accounts, no paid features and no ads. Coins are earned by focusing and can only be spent inside the game.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do I need an account?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Your progress is saved in your browser. Optional cloud sync uses a random code your browser generates, so we never learn who you are.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does it work offline?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. After the first visit the whole game is cached and runs with no connection. Only the live weather needs the network, and without it the world simply shows fair weather.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does it know my local weather without asking permission?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'It uses the approximate location our host attaches to every web request, rounded to about 11 kilometres before it is used. Your device location is never requested and no permission prompt appears.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the Pomodoro Technique?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Work for 25 minutes on one task, take a 5-minute break, and take a longer break after four rounds. When you get distracted, write the distraction down and carry on rather than chasing it.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I use PetPomo for studying?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'That is most of what it is for. Set the focus length to match your attention rather than the default — 25 minutes is a starting point, not a rule — and use the long break to leave the desk.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does a pomodoro timer help with ADHD?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Many people with ADHD say they work better against an external clock than against their own sense of time, and a visible countdown gives a task an edge, a start you can press and a finish that arrives regardless. PetPomo is a timer, not a treatment, and nothing here is medical advice.',
        },
      },
      {
        '@type': 'Question',
        name: 'What happens if I abandon a session?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'It is not counted in your stats, and your pet is briefly sad about it. That is the entire penalty.',
        },
      },
    ],
  },
];
---

<Layout
  title="PetPomo — Free Pomodoro Timer with a Virtual Pet"
  description="A free pomodoro focus timer with a virtual pet. Your cat naps through each 25-minute session in a hand-painted world that follows your real time of day and weather. No account, works offline."
  schema={schema}
  wide
>
  {/* One full screen of game, then the page proper. */}
  <div class="pp-stage-screen"><Game client:only="preact" /></div>

  <a href="#what-is" class="pp-scroll-hint" aria-label="Read about PetPomo">
    <span aria-hidden="true">↓</span>
  </a>

  <FocusLanding />

  {/* Homepage comments — same island as blog posts, target 'home'. Bottom of
      the page, loaded only when scrolled to. */}
  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-5">
    <Comments client:visible target="home" />
  </div>

  {/*
    The advertising slot. It takes no height until something is put in it, at
    which point whatever inserts the banner adds `data-filled` and the space is
    held from then on.

    Reserving it up front was the obvious move and the wrong one: an empty slot
    and the footer are both page-background, so together they read as one tall
    dead band, and the animal ended up standing on the bottom edge of its own
    world to make room for an advert that does not exist. Protection from a
    layout shift is worth having once there is something to shift.

    `aria-hidden` while empty, so a screen reader is not told about a region
    that contains nothing.
  */}
  <aside class="pp-adslot" aria-hidden="true" data-slot="footer-leaderboard"></aside>
</Layout>
