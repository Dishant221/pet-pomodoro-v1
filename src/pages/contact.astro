---
import Legal from '../layouts/Legal.astro';
import { SITE, hasContact } from '../site';
---

<Legal
  title="Contact"
  description="How to reach PetPomo about bugs, feature requests, privacy questions or a lost sync code."
  updated="2026-08-22"
  intro="Bugs, ideas, privacy questions, or a save you want deleted — all welcome."
>
  {
    hasContact ? (
      <>
        <h2>Email</h2>
        <p>
          General enquiries — <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
        <p>
          Support, bug reports and issues — <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>. You can
          also reach this straight from the app: the 💬 button next to your pet opens a short form that starts the
          email for you.
        </p>
        <p>
          It is one person reading these, so a reply may take a few days. Please include what browser you are on if
          you are reporting a bug.
        </p>
      </>
    ) : (
      /* Rendering a fake address would be worse than admitting there is not
         one yet: it bounces silently and it misleads anyone relying on it. */
      <>
        <h2>Not set up yet</h2>
        <p>
          PetPomo does not have a public contact address yet. It is a personal project that has only just gone live,
          and setting up an inbox that is actually monitored is on the list before anything here is monetised.
        </p>
        <p>
          If you have found a bug or a privacy concern in the meantime, the most reliable route is to raise it
          wherever you found the link to this site.
        </p>
      </>
    )
  }

  {
    hasContact && (
      <>
        <h2>Write to us</h2>
        <p>
          Messages go straight to the site owner. What you type here is stored so it can be read and answered
          (see the <a href="/privacy">privacy policy</a>); if the site cannot be reached, the form falls back to
          opening a ready-addressed email in your own mail app instead.
        </p>
        <form class="pp-contact-form" data-to={SITE.contactEmail} novalidate>
          {/* Honeypot: invisible to people, irresistible to form-filling bots.
              Anything typed here means the submit is dropped silently. */}
          <div class="pp-hp" aria-hidden="true">
            <label for="pp-cf-website">Website</label>
            <input id="pp-cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="pp-cf-row">
            <label for="pp-cf-name">Name <span class="pp-cf-req">*</span></label>
            <input id="pp-cf-name" name="name" type="text" required maxlength="100" autocomplete="name" />
          </div>

          <div class="pp-cf-row">
            <label for="pp-cf-email">Your email <span class="pp-cf-req">*</span></label>
            <input id="pp-cf-email" name="email" type="email" required maxlength="254" autocomplete="email" />
          </div>

          <div class="pp-cf-row">
            <label for="pp-cf-subject">Subject <span class="pp-cf-req">*</span></label>
            <input id="pp-cf-subject" name="subject" type="text" required maxlength="150" />
          </div>

          <div class="pp-cf-row">
            <label for="pp-cf-message">Message <span class="pp-cf-req">*</span></label>
            <textarea id="pp-cf-message" name="message" required maxlength="1500" rows="6" />
          </div>

          <p class="pp-cf-error" role="alert" hidden />

          <button type="submit" class="pp-cf-send">Send message</button>
        </form>
      </>
    )
  }

  <h2>What to include</h2>
  <ul>
    <li><strong>Bugs</strong> — what you did, what happened, what you expected, and your browser.</li>
    <li><strong>Privacy</strong> — see the <a href="/privacy">privacy policy</a> first; it probably answers it.</li>
    <li>
      <strong>Deleting a synced save</strong> — send the sync code and it will be removed. We cannot check who owns a
      code, so please only send your own.
    </li>
    <li><strong>Copyright</strong> — see the <a href="/copyright">copyright notice</a> for the takedown route.</li>
  </ul>

  <h2>What not to send</h2>
  <p>
    Please do not send passwords, payment details or anything sensitive. PetPomo has no accounts and takes no
    payments, so there is never a reason to.
  </p>
</Legal>

<script>
  /**
   * The form now has a server behind it: POST /api/contact stores the message
   * for the admin dashboard (and emails the owner once sending is configured
   * — worker/src/community.ts documents the pipeline). The old mailto
   * composer stays as the FALLBACK for when the API is unreachable, so the
   * page degrades to exactly what it was before.
   *
   * Bot defences are layered client + server: the honeypot field and the
   * submit-too-fast gate here (both failing silently, so a bot learns
   * nothing), then the server's honeypot check, per-IP rate limit and — once
   * configured — Turnstile.
   */
  const form = document.querySelector<HTMLFormElement>('.pp-contact-form');
  if (form) {
    const loadedAt = Date.now();
    const error = form.querySelector<HTMLParagraphElement>('.pp-cf-error')!;

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;

      // Bots fill the invisible field and submit within moments of load;
      // people do neither. Both checks fail silently on purpose.
      if (field('website').value !== '' || Date.now() - loadedAt < 2500) return;

      const name = field('name').value.trim().slice(0, 100);
      const email = field('email').value.trim().slice(0, 254);
      const subject = field('subject').value.trim().slice(0, 150);
      const message = field('message').value.trim().slice(0, 1500);

      if (!name || !email || !subject || !message || !field('email').checkValidity()) {
        error.textContent = 'Please fill in every field, with a valid email address.';
        error.hidden = false;
        return;
      }

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, email, subject, message, website: '' }),
        });
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        if (res.ok) {
          form.reset();
          error.textContent = 'Sent — thank you. It is one person reading these, so a reply may take a few days.';
          error.hidden = false;
          return;
        }
        if (data.error) {
          error.textContent = data.error;
          error.hidden = false;
          return;
        }
      } catch {
        /* API unreachable — fall through to the mailto composer below. */
      }

      const to = form.dataset.to!;
      const body = `From: ${name} <${email}>\n\n${message}`;
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(`[PetPomo] ${subject}`)}&body=${encodeURIComponent(body)}`;

      error.textContent = 'Your email app should now be open with the message ready to send.';
      error.hidden = false;
    });
  }
</script>

<style>
  .pp-contact-form {
    display: grid;
    gap: 0.8rem;
    max-width: 34rem;
  }

  /* Off-screen rather than display:none — some bots skip hidden inputs. */
  .pp-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .pp-cf-row {
    display: grid;
    gap: 0.25rem;
  }

  .pp-cf-row label {
    font-weight: 600;
    color: var(--ink);
    font-size: 0.8rem;
  }

  .pp-cf-req {
    color: var(--accent);
  }

  .pp-cf-row input,
  .pp-cf-row textarea {
    padding: 0.5rem 0.65rem;
    font: inherit;
    font-size: 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--ink);
  }

  .pp-cf-row textarea {
    resize: vertical;
  }

  .pp-cf-row input:focus-visible,
  .pp-cf-row textarea:focus-visible,
  .pp-cf-send:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pp-cf-error {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink);
  }

  .pp-cf-send {
    justify-self: start;
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
  }
</style>
