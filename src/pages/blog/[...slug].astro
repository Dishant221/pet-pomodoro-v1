---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE, legalName } from '../../site';

export async function getStaticPaths() {
  // Drafts are built locally but never published, so a half-finished post
  // cannot leak into the sitemap by being forgotten.
  const posts = await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/**
 * BlogPosting structured data.
 *
 * This is what produces a dated, attributed result in search rather than a
 * bare link, and it is the difference between an article being understood as
 * an article and being understood as another page of the app.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: { '@type': 'Organization', name: legalName, url: SITE.url },
  publisher: { '@type': 'Organization', name: legalName, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: post.data.tags.join(', '),
  isAccessibleForFree: true,
};
---

<Layout title={`${post.data.title} — PetPomo`} description={post.data.description} schema={schema}>
  <article class="pp-legal mx-auto grid max-w-3xl gap-5">
    <header class="grid gap-2">
      <p class="text-xs">
        <a href="/blog" class="underline underline-offset-2" style="color: var(--ink-soft)">← Blog</a>
      </p>
      <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{post.data.title}</h1>
      <p class="text-xs" style="color: var(--ink-soft)">
        <time datetime={post.data.publishedAt.toISOString()}>{fmt(post.data.publishedAt)}</time>
        {
          post.data.updatedAt && (
            <span>
              {' '}· updated <time datetime={post.data.updatedAt.toISOString()}>{fmt(post.data.updatedAt)}</time>
            </span>
          )
        }
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(' · ')}</span>}
      </p>
    </header>

    <div class="pp-prose grid gap-4 text-sm leading-relaxed" style="color: var(--ink-soft)">
      <Content />
    </div>

    <aside class="pp-card p-5 text-sm" style="color: var(--ink-soft)">
      <p>
        <strong style="color: var(--ink)">PetPomo</strong> is a free pomodoro timer with a cat who naps while you
        focus. <a href="/" class="underline underline-offset-2">Start a session</a> — no account needed.
      </p>
    </aside>
  </article>
</Layout>

<style is:global>
  /* Markdown output needs its own rhythm; the app's utility classes never
     touch it because the HTML comes from the compiler, not from a template. */
  .pp-prose h2 {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.125rem;
    margin-top: 1rem;
    letter-spacing: -0.01em;
  }
  .pp-prose h3 {
    color: var(--ink);
    font-weight: 600;
    font-size: 1rem;
    margin-top: 0.5rem;
  }
  .pp-prose ul,
  .pp-prose ol {
    display: grid;
    gap: 0.45rem;
    padding-left: 1.2rem;
  }
  .pp-prose ul { list-style: disc; }
  .pp-prose ol { list-style: decimal; }
  .pp-prose a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pp-prose strong { color: var(--ink); }
  .pp-prose code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }
</style>
