---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import PostCard from '../components/PostCard.astro';
import PostToc from '../components/PostToc.astro';
import { SITE, legalName } from '../site';
import { fmtDate, readingMinutes, relatedPosts, sortByDate, tagLabel, tagSlug } from '../blog/util';

/**
 * Blog articles live directly under the root — www.pomodoropet.com/the-slug/ —
 * with no /blog/ prefix. The old /blog/<slug>/ URLs 301 to here via
 * public/_redirects, which scripts/make-redirects.mjs regenerates from the
 * content folder.
 */
export async function getStaticPaths() {
  // Drafts are built locally but never published, so a half-finished post
  // cannot leak into the sitemap by being forgotten.
  const posts = await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
// `headings` feeds the sidebar's "On this page" list; the anchors they point
// at are the ids Astro already puts on every markdown heading.
const { Content, headings } = await render(post);

const url = new URL(`/${post.id}/`, Astro.site).href;
const minutes = readingMinutes(post);

const all = sortByDate(await getCollection('blog', ({ data }) => !data.draft));
const related = relatedPosts(post, all, 3);

// Social cards want ~1200×630; the same optimised file feeds the schema.
const ogAsset = post.data.image
  ? await getImage({ src: post.data.image, width: 1200, format: 'jpg' })
  : null;
const ogImage = ogAsset ? new URL(ogAsset.src, Astro.site).href : undefined;

/**
 * BlogPosting + BreadcrumbList structured data.
 *
 * The article schema is what produces a dated, attributed result in search;
 * the breadcrumb is what makes the result show "pomodoropet.com › Blog"
 * instead of a bare URL, and both feed answer engines assembling citations.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    author: { '@type': 'Organization', name: legalName, url: SITE.url },
    publisher: { '@type': 'Organization', name: legalName, url: SITE.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    keywords: post.data.tags.join(', '),
    isAccessibleForFree: true,
    timeRequired: `PT${minutes}M`,
    inLanguage: 'en',
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    ...(post.data.tags[0] ? { articleSection: tagLabel(post.data.tags[0]) } : {}),
    ...(ogImage ? { image: ogImage } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<Layout
  title={`${post.data.title} — PetPomo`}
  description={post.data.description}
  noindex={!post.data.searchIndex}
  schema={schema}
  ogImage={ogImage}
  article={{
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    tags: post.data.tags,
  }}
>
  {/* Article + right rail. The rail is a fixed 300px (it holds a 300×250 ad
      unit); the article takes the rest, which lands close to a comfortable
      70ch measure inside the layout's max-w-5xl. Below lg the rail stacks
      underneath the article. */}
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
  <article class="grid min-w-0 gap-5">
    <header class="grid gap-2">
      <nav aria-label="Breadcrumb" class="text-xs" style="color: var(--ink-soft)">
        <a href="/" class="pp-focus-ring rounded underline underline-offset-2">Home</a>
        <span aria-hidden="true"> › </span>
        <a href="/blog/" class="pp-focus-ring rounded underline underline-offset-2">Blog</a>
      </nav>
      <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{post.data.title}</h1>
      <p class="text-xs" style="color: var(--ink-soft)">
        <time datetime={post.data.publishedAt.toISOString()}>{fmtDate(post.data.publishedAt)}</time>
        {
          post.data.updatedAt && (
            <span>
              {' '}· updated <time datetime={post.data.updatedAt.toISOString()}>{fmtDate(post.data.updatedAt)}</time>
            </span>
          )
        }
        <span> · {minutes} min read</span>
      </p>
      {
        post.data.tags.length > 0 && (
          <p class="flex flex-wrap gap-1.5">
            {post.data.tags.map((t) => (
              <a href={`/blog/topic/${tagSlug(t)}/`} class="pp-focus-ring pp-tag-chip">
                {tagLabel(t)}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      post.data.image && (
        <figure class="pp-post-hero">
          <Image
            src={post.data.image}
            alt={post.data.imageAlt ?? ''}
            width={1280}
            loading="eager"
            fetchpriority="high"
          />
          {post.data.imageCredit && (
            <figcaption class="pp-post-credit">
              {post.data.imageCreditUrl ? (
                <a href={post.data.imageCreditUrl} rel="noopener nofollow" target="_blank">
                  {post.data.imageCredit}
                </a>
              ) : (
                post.data.imageCredit
              )}
            </figcaption>
          )}
        </figure>
      )
    }

    <AdSlot variant="banner" slotId="post-top" />

    <PostToc headings={headings} />

    <div id="pp-prose" class="pp-prose grid gap-5" style="color: var(--ink-soft)">
      <Content />
    </div>

    <aside class="pp-card p-5 text-sm" style="color: var(--ink-soft)">
      <p>
        <strong style="color: var(--ink)">PetPomo</strong> is a free pomodoro timer with a cat who naps while you
        focus. <a href="/" class="underline underline-offset-2">Start a session</a> — no account needed.
      </p>
    </aside>

    <AdSlot variant="rectangle" slotId="post-bottom" />

    {
      related.length > 0 && (
        <section aria-labelledby="pp-related-h" class="grid gap-3">
          <h2 id="pp-related-h" class="text-lg font-bold tracking-tight" style="color: var(--ink)">
            Keep reading 🐾
          </h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <BlogSidebar posts={all} headings={headings} />
  </div>
</Layout>

<script>
  import { mountFocusGame } from '../blog/minigames';
  mountFocusGame(document.getElementById('pp-prose'));
</script>

{/* Article prose styles live in global.css (.pp-prose) — they are shared
    with the About page, which is styled as a blog article. */}
