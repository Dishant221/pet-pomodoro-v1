---
import Layout from '../layouts/Layout.astro';
import AdminApp from '../islands/AdminApp.tsx';

/**
 * The admin dashboard shell. This static page is PUBLIC and deliberately
 * empty: every piece of admin data arrives at runtime from /api/admin/*,
 * which re-checks the session's role server-side on every request
 * (worker/src/admin.ts). The island (src/islands/AdminApp.tsx) probes that
 * gate and explains itself to non-admins. noindex, obviously.
 */
---

<Layout title="Admin — PetPomo" description="PetPomo admin dashboard." noindex>
  <AdminApp client:only="preact" />
</Layout>
