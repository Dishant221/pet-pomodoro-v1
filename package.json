{
  "name": "pet-pomodoro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "db:local": "wrangler d1 execute petpomo --local --file=worker/schema.sql",
    "db:remote": "wrangler d1 execute petpomo --remote --file=worker/schema.sql",
    "db:preview": "wrangler d1 execute petpomo-preview --remote --file=worker/schema.sql",
    "dev:full": "astro build && wrangler pages dev dist",
    "budget": "node scripts/budget.mjs",
    "test:e2e": "node tests/acceptance.mjs",
    "test:sync": "node tests/sync.mjs",
    "og": "node scripts/make-og.mjs",
    "deploy": "cross-env PUBLIC_SITE_URL=https://petpomo.pages.dev astro build && wrangler pages deploy dist --project-name petpomo --branch main",
    "deploy:preview": "cross-env PUBLIC_SITE_URL=https://preview.petpomo.pages.dev astro build && wrangler pages deploy dist --project-name petpomo --branch preview"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@nanostores/preact": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "gsap": "^3.15.0",
    "hono": "^4.13.0",
    "nanostores": "^1.4.2",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/three": "^0.185.4",
    "cross-env": "10.1.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.119.0"
  }
}
