{
  "name": "pet-pomodoro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/make-slugs.mjs && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "db:local": "wrangler d1 migrations apply petpomo --local",
    "db:remote": "wrangler d1 migrations apply petpomo --remote --env production",
    "db:preview": "wrangler d1 migrations apply petpomo-preview --remote --env preview",
    "dev:full": "astro build && wrangler dev --port 4332",
    "budget": "node scripts/budget.mjs",
    "metrics": "node scripts/cf-metrics.mjs",
    "test:e2e": "node tests/acceptance.mjs",
    "test:sync": "node tests/sync.mjs",
    "test:talk": "node tests/verify-talk.mjs",
    "test:auth": "node tests/auth.mjs",
    "test:community": "node tests/community.mjs",
    "og": "node scripts/make-og.mjs",
    "deploy": "cross-env PUBLIC_SITE_URL=https://www.pomodoropet.com PUBLIC_GOOGLE_LOGIN=1 astro build && wrangler deploy --env production",
    "deploy:preview": "cross-env PUBLIC_SITE_URL=https://petpomo-preview.totadedishant.workers.dev PUBLIC_GOOGLE_LOGIN=1 astro build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@nanostores/preact": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "better-auth": "^1.7.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.7",
    "nanostores": "^1.4.2",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/three": "^0.185.4",
    "better-sqlite3": "^12.11.1",
    "cross-env": "10.1.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
